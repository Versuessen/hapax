 "fields": [
  [
   "word",
   "Written word (surface form)",
   "The exact form printed in the corpus. Searching word = went finds went, not necessarily go or going."
  ],
  [
   "lexeme",
   "Base word / headword search",
   "Searches inflected forms of the same lexical entry when the corpus offers it. In BNC/BNC-BABY this uses hw, in CLMET/EFCAM etc. lemma. A lexeme is an abstract vocabulary item such as GO, realized as go, went, going."
  ],
  [
   "lemma",
   "Stored lemma annotation",
   "An indexed normalization of a token. In BNC and BNC-BABY it includes a grammatical suffix, e.g. go_VERB; in other corpora it may be plain go. For everyday base-word searches use lexeme."
  ],
  [
   "hw",
   "BNC headword",
   "BNC/BNC-BABY base-word attribute, such as go for went and going; may combine different parts of speech."
  ],
  [
   "pos",
   "Part of speech (POS)",
   "A corpus-specific label classifying a token as noun, verb, adjective, etc. Codes differ between Brown, BNC C5, BNC2014 CLAWS7, and Penn-style corpora; ambiguous tags do not give a definite grammatical decision."
  ],
  [
   "class",
   "Broad grammatical class",
   "A coarser automatic classification; e.g. SUBST, VERB, ADJ. Broad classes need not match a narrow classroom definition of adjective or noun."
  ],
  [
   "type",
   "Corpus-specific token type",
   "An additional indexing field. Its precise values must be inspected in this corpus; it is not automatically the same as a linguistic word type or lexeme."
  ],
  [
   "head",
   "Dependency head token ID",
   "The local sentence token ID of the governing word; zero indicates a root. Used by EFCAM."
  ],
  [
   "tokid",
   "Sentence-local token identifier",
   "A token number that restarts in each indexed sentence; used to resolve dependency edges in EFCAM."
  ],
  [
   "rel",
   "Dependency relation",
   "The grammatical relationship between a token and its head, e.g. nsubj = nominal subject; EFCAM uses Stanford-style labels."
  ],
  [
   "usas",
   "Semantic annotation code",
   "Code for a semantic category. Look up the specific USAS tagset; do not confuse semantic domains with part-of-speech tags."
  ],
  [
   "text_genre",
   "Text genre",
   "The type of writing or speech, such as drama or narrative fiction. Codes may be corpus-specific (e.g. W:ac:medicine)."
  ],
  [
   "text_period",
   "Historical period",
   "Time period assigned to a text, useful for diachronic (across-time) comparisons."
  ],
  [
   "text_decade",
   "Approximate decade",
   "Stored time span or decade. Some CLMET values cover ranges; retain exact underlying codes."
  ],
  [
   "text_id",
   "Document identifier",
   "Identifies the document/text source; not its grammatical classification."
  ],
  [
   "file_id",
   "File identifier",
   "The corpus file or source identifier, such as A01 in Brown."
  ],
  [
   "s_id",
   "Sentence identifier",
   "ID of the indexed sentence; useful to locate examples reproducibly."
  ]
 ],
 "concepts": [
  [
   "Token",
   "One indexed occurrence. In “go go!”, the word go occurs twice: two tokens."
  ],
  [
   "Type",
   "One distinct written form. In “go go!”, there is one written form go, but two tokens. A corpus field named type may use a different encoding."
  ],
  [
   "Lemma",
   "Dictionary base form assigned to a token (usually morphological normalization). The precise field is corpus-dependent."
  ],
  [
   "Lexeme",
   "An abstract vocabulary entry linking inflections, e.g. GO → go, goes, went, going. The GUI chooses the corpus-supported index."
  ],
  [
   "POS tag",
   "A part-of-speech category assigned to a token, e.g. noun, adjective, or verb. Some values represent ambiguity, not certainty."
  ],
  [
   "Concordance / KWIC",
   "A line of actual corpus text showing words to the left and right of a highlighted match (Key Word In Context)."
  ],
  [
   "Collocate",
   "A word occurring near the search match. Raw neighboring-word counts alone do not prove a statistically significant association."
  ],
  [
   "Concordance frequency",
   "How many matching spans satisfy the query, not necessarily the number of unique documents or word types."
  ],
  [
   "Normalized rate",
   "A count scaled by corpus size, e.g. occurrences per million indexed tokens. Compare like with like."
  ],
  [
   "Metadata filter",
   "Restrict matches to documents with a property such as genre, year or speaker age."
  ],
  [
   "Union",
   "Combine two sets of exact matched token spans. Duplicated spans appear once."
  ],
  [
   "Intersection",
   "Keep only identical matched spans found by both searches. Not the same as words co-occurring in one sentence."
  ],
  [
   "Difference",
   "Keep spans from the first result that are absent from the second."
  ],
  [
   "Ambiguity tag",
   "C5 AJ0-VVG: adjective preferred, -ing verb possible. C5 VVG-AJ0: -ing verb preferred, adjective possible."
  ],
  [
   "Dependency relation",
   "A grammatical link, e.g. nsubj = the noun/pronoun functioning as subject of a verb."
  ]
 ],
